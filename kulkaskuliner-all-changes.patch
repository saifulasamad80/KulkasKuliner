+
+  const message = `Halo, terkait pesanan ${orderNumber} di KulkasKuliner. Ada informasi mengenai produk/pesanan Anda.`;
+  return `https://wa.me/${normalized}?text=${encodeURIComponent(message)}`;
+}
+
